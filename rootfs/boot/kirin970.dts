/dts-v1/;

/ {
	compatible = "Hisilicon,kirin970-hikey970", "Hisilicon,kirin970";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "HiKey970";

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		gpio-range {
			#pinctrl-single,gpio-range-cells = <0x03>;
			linux,phandle = <0x02>;
			phandle = <0x02>;
		};

		pinmux@e896c000 {
			compatible = "pinctrl-single";
			reg = <0x00 0xe896c000 0x00 0x72c>;
