			phandle = <0x15>;

			uart0_pmx_func {
				pinctrl-single,pins = <0x54 0x02 0x58 0x02>;
				linux,phandle = <0x05>;
				phandle = <0x05>;
			};

			uart2_pmx_func {
				pinctrl-single,pins = <0x700 0x02 0x704 0x02 0x708 0x02 0x70c 0x02>;
