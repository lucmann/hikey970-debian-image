	aliases {
		mshc1 = "/soc/dwmmc1@ff37f000";
		mshc2 = "/soc/dwmmc2@FC183000";
		serial0 = "/soc/serial@fdf02000";
		serial1 = "/soc/serial@fdf00000";
		serial2 = "/soc/serial@fdf03000";
		serial3 = "/soc/serial@ffd74000";
		serial4 = "/soc/serial@fdf01000";
		serial5 = "/soc/serial@fdf05000";
		serial6 = "/soc/serial@fff32000";
	};

	chosen {
		stdout-path = "serial6:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
	};

	reboot-mode-syscon@32100000 {
		compatible = "syscon", "simple-mfd";
		reg = <0x00 0x32100000 0x00 0x1000>;

		reboot-mode {
			compatible = "syscon-reboot-mode";
			offset = <0x00>;
			mode-normal = <0x77665501>;
			mode-bootloader = "wfU";
			mode-recovery = <0x77665502>;
		};
	};

	apb_pclk {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x1312d00>;
		clock-output-names = "apb_pclk";
		linux,phandle = <0x80>;
		phandle = <0x80>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <0xac 0xad>;

		power {
			wakeup-source;
			gpios = <0x1c 0x03 0x01>;
			label = "GPIO Power";
			linux,code = <0x74>;
		};
	};

	hifidsp {
		compatible = "hisilicon,k3hifidsp";
	};

	leds {
		compatible = "gpio-leds";

		sdcard_active_led {
			label = "sdcard_active";
			gpios = <0xae 0x00 0x00>;
			linux,default-trigger = "mmc0";
		};

		gps_active_led {
			label = "gps_active";
			gpios = <0x0d 0x01 0x00>;
			default-state = "off";
		};

		bt_active_led {
			label = "bt_active";
			gpios = <0xaf 0x03 0x00>;
			linux,default-trigger = "hci0rx";
			default-state = "off";
		};

		wlan_active_led {
			label = "wifi_active";
			gpios = <0x1d 0x00 0x00>;
			linux,default-trigger = "phy0tx";
			default-state = "off";
		};

		can_active_led {
			label = "can_active";
			gpios = <0x47 0x04 0x00>;
			linux,default-trigger = "can0-rxtx";
			default-state = "off";
		};
	};

	vdec {
		compatible = "hisi,kirin970-vdec";
		reg = <0x00 0xe8800000 0x00 0x40000>;
		interrupts = <0x00 0x122 0x04 0x00 0x123 0x04 0x00 0x124 0x04>;
		clocks = <0xab 0x00>;
		clock-names = "clk_gate_vdecfreq";
		dec_clk_rate = <0x1ad27480 0x11e1a300 0xb06e040>;
		vdec_fpga = <0x01>;
		status = "ok";

		iommu_info {
			start-addr = <0x40000>;
			size = <0xe0000000>;
		};
	};

	venc {
		compatible = "hisi,kirin970-venc";
		reg = <0x00 0xe8880000 0x00 0x40000>;
		interrupts = <0x00 0x128 0x04 0x00 0x129 0x04 0x00 0x12a 0x04>;
		clocks = <0xab 0x01>;
		clock-names = "clk_gate_vencfreq";
		enc_clk_rate = <0x21055e80 0x1ad27480 0xe2f9780>;
		venc_fpga = <0x01>;
		status = "ok";

		iommu_info {
			start-addr = <0x40000>;
			size = <0xe0000000>;
		};
	};

	smmu_lpae {
		compatible = "hisi,hisi-smmu-lpae";
		status = "ok";
	};

	gps-en-1-8v {
		compatible = "regulator-fixed";
		regulator-name = "gps-en-regulator";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		gpio = <0xa4 0x00 0x00>;
		regulator-always-on;
		startup-delay-us = <0x3a98>;
		enable-active-high;
	};

	wlan-en-1-8v {
		compatible = "regulator-fixed";
		regulator-name = "wlan-en-regulator";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		gpio = <0x0d 0x03 0x00>;
		startup-delay-us = <0x11170>;
		enable-active-high;
		linux,phandle = <0x2c>;
		phandle = <0x2c>;
	};

	kim {
		compatible = "kim";
		nshutdown_gpio = <0x1ce>;
		dev_name = "/dev/ttyAMA4";
		flow_cntrl = <0x01>;
		baud_rate = <0x1c200>;
	};

	btwilink {
		compatible = "btwilink";
	};
};
