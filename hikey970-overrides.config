# HIKEY970 / HiSilicon overrides extracted from hikey970-v4.19.config
# Append these to a v6.19 base `.config` (see instructions below)

CONFIG_ARCH_HISI=y
CONFIG_PCI_HISI=y
CONFIG_PCIE_KIRIN=y
CONFIG_ARM_HISI_CPUIDLE=y
CONFIG_HISI_HIKEY_USB=y
CONFIG_SCSI_HISI_SAS=y
CONFIG_SCSI_UFS_HISI=y
CONFIG_NET_VENDOR_HISILICON=y
CONFIG_INPUT_HISI_POWERKEY=y
CONFIG_HW_RANDOM_HISI=m
CONFIG_POWER_RESET_HISI=y
CONFIG_HISI_THERMAL=y
CONFIG_HISI_PMIC_PMU_SPMI=y
CONFIG_MFD_HISI_IP_CORE=y
CONFIG_HISI_REGULATOR_SPMI=y
CONFIG_DRV_HISI_IP_REGULATOR=y
CONFIG_VIDEO_HISI_ISP=y
CONFIG_MALI_PLATFORM_HIKEY970=y
CONFIG_MALI_PLATFORM_NAME="devicetree"
CONFIG_DRM_PANEL_HIKEY960_NTE300NTS=y
CONFIG_DRM_HISI_KIRIN=m
CONFIG_HISI_KIRIN_DW_DSI=y
CONFIG_DRM_KIRIN_960=y
CONFIG_HISI_FB_970=y
CONFIG_SND_I2S_HISI_I2S=y
CONFIG_USB_DWC3_HISI=y
CONFIG_HISI_ASP_DMA=y
CONFIG_HISI_DMA=y
CONFIG_ION_HISI=y
CONFIG_COMMON_CLK_HI3660=y
CONFIG_COMMON_CLK_KIRIN970=y
CONFIG_RESET_HISI=y
CONFIG_STUB_CLK_KIRIN970=y
CONFIG_HISI_IODOMAIN_API=y
CONFIG_HISI_IOMMU=y
CONFIG_HISI_IOMMU_LPAE=y
CONFIG_HISI_DDR_DEVFREQ=y
CONFIG_HISILICON_IRQ_MBIGEN=y
CONFIG_COMMON_RESET_HI3660=y
CONFIG_COMMON_RESET_USB31MISC_KIRIN970=y
CONFIG_PHY_KIRIN970_USB=y
CONFIG_HISILICON_PLATFORM=y
CONFIG_HISILICON_PLATFORM_MAILBOX=y
CONFIG_HISI_MAILBOX=y
CONFIG_HISI_RPROC=y
CONFIG_HIKEY970_HIFI=y
CONFIG_HISI_ICS_IPU_PLATFORM=y
CONFIG_HISI_ICS_IPU=y

# End of overrides
