# Filtered HIKEY970 / HiSilicon overrides (only symbols present in arm64-v6.19.config)

CONFIG_ARCH_HISI=y
CONFIG_PCI_HISI=y
CONFIG_PCIE_KIRIN=y
CONFIG_HISI_HIKEY_USB=y
CONFIG_SCSI_HISI_SAS=y
CONFIG_SCSI_UFS_HISI=y
CONFIG_NET_VENDOR_HISILICON=y
CONFIG_INPUT_HISI_POWERKEY=y
CONFIG_HW_RANDOM_HISI=m
CONFIG_POWER_RESET_HISI=y
CONFIG_HISI_THERMAL=y
CONFIG_DRM_HISI_KIRIN=m
CONFIG_HISI_DMA=y
CONFIG_RESET_HISI=y
CONFIG_HISILICON_IRQ_MBIGEN=y
CONFIG_COMMON_CLK_HI3660=y
CONFIG_COMMON_RESET_HI3660=y

# Note: other hi-key/hisilicon options from the v4.19 config (for example
# CONFIG_MALI_PLATFORM_HIKEY970, CONFIG_HISI_DDR_DEVFREQ, CONFIG_ION_HISI,
# CONFIG_PHY_KIRIN970_USB, etc.) are not present in v6.19 mainline and
# therefore are not included here. They need out-of-tree drivers or
# the appropriate renamed/mainline equivalents.
